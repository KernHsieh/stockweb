# ===============================================
# StockWeb Environment Configuration
# ===============================================

# 1. Main Database URL for Backend
# Local default (SQLite):
DATABASE_URL=sqlite:///./stockweb.db

# Or Cloud PostgreSQL (e.g. Supabase / Neon / Render):
# DATABASE_URL=postgresql://postgres.xxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. Database Sync Engine Configuration (for sync_db.py)
# Your Cloud PostgreSQL database connection string:
CLOUD_DATABASE_URL=postgresql://postgres.xxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Your Local PostgreSQL database connection string:
LOCAL_DATABASE_URL=sqlite:///./stockweb.db
# Or Local Postgres: postgresql://postgres:password@localhost:5432/stockweb
